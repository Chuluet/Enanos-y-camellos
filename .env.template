# =============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO
# =============================================================================
# Este archivo SÍ va al repositorio: es la guía de qué variables hacen falta.
# El .env real NO va (está en .gitignore), porque lleva credenciales.
#
# Para empezar:
#     cp .env.template .env
# y completá los valores de abajo. Después: docker compose up -d
#
# No hace falta el --build: el compose.yml tiene pull_policy: build, así que
# reconstruye la imagen en cada "up" sin que tengas que borrar nada.
# =============================================================================

# Nombre de la base de datos que crea Postgres al arrancar por primera vez.
DB_NAME=enanosycamellos_db

# Usuario y contraseña de Postgres. Se crean automáticamente en el contenedor.
# Poné lo que quieras en desarrollo; en producción usá valores fuertes.
DB_USER=postgres
DB_PASSWORD=changeme

# Puerto de TU MÁQUINA (el host) por el que vas a poder entrar a la base,
# por ejemplo desde DBeaver o psql.
# Dentro de la red de Docker los contenedores siempre se hablan por el 5432,
# así que esto NO afecta a la app: solo cambia por dónde entrás vos.
# Si ya tenés un Postgres local ocupando el 5432, poné 5433 acá.
DB_PORT=5432

# Puerto de TU MÁQUINA por el que entrás a Keycloak (consola de administración
# en /admin, con admin/admin). Adentro de Docker siempre es el 8080, igual que
# con la base. Si lo cambiás acá, cambialo también en el navegador: los tokens
# se emiten con esta dirección adentro y la app compara contra ella.
KEYCLOAK_PORT=8180

# Usuario y contraseña del administrador de Keycloak (la consola /admin, NO
# los usuarios de prueba de la app como "organizer" o "viewer" — esos ya
# vienen precargados en el realm importado).
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Nombre del realm y del client id, tal como quedaron definidos en
# keycloak/realm-enanosycamellos.json al importarse. Si cambiás estos valores
# acá, tenés que actualizar ese mismo archivo JSON a mano para que coincidan
# (si no, Keycloak nunca va a encontrar el realm/cliente que esperás).
KEYCLOAK_REALM=enanosycamellos
KEYCLOAK_CLIENT_ID=enanosycamellos-swagger

# Puerto de TU MÁQUINA por el que entrás al backend (Swagger, API REST).
# Default 8080, no hace falta tocarlo salvo que ya tengas algo ocupando ese
# puerto.
APP_PORT=8080

# Puerto de TU MÁQUINA por el que entrás al frontend (la app web de React).
# Default 8082, elegido para no chocar con el 8080/8081 que usan otros
# servicios.
FRONTEND_PORT=8082